# Research Studio (open edition) — copy to .env and fill in.

# Public address of this server (https in production; cookies are marked Secure then)
BASE_URL=http://localhost:4150
PORT=4150
# 127.0.0.1 behind a reverse proxy; 0.0.0.0 to listen on every interface
HOST=127.0.0.1

# Two different random secrets of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Encrypts manuscripts at rest (AES-256-GCM). Keep it safe: without it the stored data cannot be read.
DATA_KEY=

# Accounts: by default the first account (the administrator) and invited people can sign up.
# OPEN_SIGNUP=1
# Extra administrators (comma-separated emails)
# STUDIO_ADMINS=you@example.org

# Email: plain SMTP to a relay on this machine (e.g. Postfix on 127.0.0.1:25, no login).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_FROM_ADDR=no-reply@example.org
MAIL_FROM_NAME=Research Studio
# Write emails to var/outbox instead of sending them (testing, or no mail server):
# MAIL_MODE=file

# Limits
MAX_PROJECTS=60
MAX_UPLOAD_MB=80
INVITES_DAILY=60
PRECHECK_DAILY=8
